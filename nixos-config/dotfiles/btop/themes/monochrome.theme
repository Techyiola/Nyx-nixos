# Monochrome btop theme — matches the alacritty/i3 grayscale palette
# (#0D0D0D background, #E6E6E6 text, dims around #7A7A7A).
# Colors are in #RRGGBB form; empty gradient stops are allowed.

# Main background, empty for terminal default
theme[main_bg]="#0D0D0D"

# Main text color
theme[main_fg]="#E6E6E6"

# Title color for boxes
theme[title]="#F0F0F0"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#B9B9B9"

# Background color of selected item in processes box
theme[selected_bg]="#3A3A3A"

# Foreground color of selected item in processes box
theme[selected_fg]="#F2F2F2"

# Color of inactive/disabled text
theme[inactive_fg]="#555555"

# Color of text appearing on top of graphs
theme[graph_text]="#A8A8A8"

# Background color of the percentage meters
theme[meter_bg]="#2A2A2A"

# Misc colors for processes box
theme[proc_misc]="#9A9A9A"

# Box outlines (varied brightness keeps the boxes distinguishable)
theme[cpu_box]="#8A8A8A"
theme[mem_box]="#767676"
theme[net_box]="#6A6A6A"
theme[proc_box]="#8A8A8A"

# Box divider line and small boxes line color
theme[div_line]="#333333"

# Temperature graph colors (dim -> bright)
theme[temp_start]="#5A5A5A"
theme[temp_mid]="#A8A8A8"
theme[temp_end]="#F0F0F0"

# CPU graph colors (low load dim, high load bright)
theme[cpu_start]="#3C3C3C"
theme[cpu_mid]="#8C8C8C"
theme[cpu_end]="#E6E6E6"

# Mem/Disk free meter (recedes into the background)
theme[free_start]="#3A3A3A"
theme[free_mid]=""
theme[free_end]="#666666"

# Mem/Disk cached meter
theme[cached_start]="#4A4A4A"
theme[cached_mid]=""
theme[cached_end]="#808080"

# Mem/Disk available meter
theme[available_start]="#5A5A5A"
theme[available_mid]=""
theme[available_end]="#A0A0A0"

# Mem/Disk used meter (brightest, most important)
theme[used_start]="#808080"
theme[used_mid]="#B0B0B0"
theme[used_end]="#E6E6E6"

# Download graph colors
theme[download_start]="#4A4A4A"
theme[download_mid]=""
theme[download_end]="#D0D0D0"

# Upload graph colors
theme[upload_start]="#4A4A4A"
theme[upload_mid]=""
theme[upload_end]="#A8A8A8"

# Process box mini graphs
theme[process_start]="#3C3C3C"
theme[process_mid]="#8C8C8C"
theme[process_end]="#E6E6E6"
