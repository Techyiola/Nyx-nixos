#!/usr/bin/env bash
#
# bluetooth-menu-window — show/hide bluetui in a floating scratchpad window.
# Bound to Super+B in ~/.config/i3/config.
#
# The i3 config owns the looks:
#   for_window [class="^bluetoothmenu$"] mark --replace bluetoothmenu,
#       floating enable, move position center, move scratchpad
# so this script only has to (a) toggle an existing window and (b) spawn a new
# one already matching that class.
#
# Focus is explicit: after `scratchpad show` the window can come up while
# another app keeps the keyboard, which looks like "the menu is there but does
# not work". A visible-but-unfocused menu is focused rather than hidden; only a
# focused menu is hidden by the next press.
#
set -u

CLASS=bluetoothmenu.local
APP=bluetui
TERM_CMD="${TERMINAL:-ghostty}"
# Final geometry, applied by the script after the terminal has settled on its
# grid (the window is transparent while it resizes, so nothing is visible).
WIDTH=720
HEIGHT=460

note() {
    command -v notify-send >/dev/null 2>&1 &&
        notify-send -a "Bluetooth" "$1" "${2:-}" >/dev/null 2>&1 || true
}

have_i3() {
    command -v i3-msg >/dev/null 2>&1 && i3-msg -t get_version >/dev/null 2>&1
}

# "<workspace>\t<focused>" for the menu window, or nothing if it is not there.
# A parked scratchpad window lives under the __i3_scratch workspace, which is
# how "show it" is told apart from "it is already up".
window_state() {
    local tree
    tree=$(i3-msg -t get_tree 2>/dev/null) || return 1
    command -v jq >/dev/null 2>&1 || return 1
    jq -r --arg c "$CLASS" '
        def scan($ws):
            (if .type == "workspace" then .name else $ws end) as $w
            | if ((.window_properties // {}).class // "") == $c
              then "\($w)\t\(.focused // false)"
              else (((.nodes // [])[] | scan($w)),
                    ((.floating_nodes // [])[] | scan($w)))
              end;
        scan("")' <<<"$tree" 2>/dev/null | head -n1
}

window_exists() {
    local tree
    tree=$(i3-msg -t get_tree 2>/dev/null) || return 1
    if command -v jq >/dev/null 2>&1; then
        jq -e --arg c "$CLASS" \
            '.. | objects | select((.window_properties // {}).class == $c)' \
            <<<"$tree" >/dev/null 2>&1
    else
        grep -q "\"class\":\"$CLASS\"" <<<"$tree"
    fi
}

msgs() { i3-msg "[class=\"^${CLASS}\$\"] $1" >/dev/null 2>&1; }

window_size() {
    i3-msg -t get_tree 2>/dev/null |
        jq -r --arg c "$CLASS" \
            '.. | objects | select((.window_properties // {}).class == $c)
             | "\(.rect.width)x\(.rect.height)"' 2>/dev/null | head -n1
}

window_id() {
    i3-msg -t get_tree 2>/dev/null |
        jq -r --arg c "$CLASS" \
            '.. | objects | select((.window_properties // {}).class == $c)
             | .window' 2>/dev/null | head -n1
}

# Hide/show the client via picom's _NET_WM_WINDOW_OPACITY property, so the
# resize/centre below happens unseen. No-op if xprop or picom is unavailable.
set_opacity() {
    local wid
    command -v xprop >/dev/null 2>&1 || return 0
    wid=$(window_id)
    [[ -n $wid && $wid != null ]] || return 0
    if [[ $1 == hidden ]]; then
        xprop -id "$wid" -f _NET_WM_WINDOW_OPACITY 32c \
            -set _NET_WM_WINDOW_OPACITY 0 >/dev/null 2>&1
    else
        xprop -id "$wid" -remove _NET_WM_WINDOW_OPACITY >/dev/null 2>&1
    fi
    return 0
}

# Ghostty resizes itself to its terminal grid just after the window is mapped.
# Wait until the size stops changing, otherwise the size/centre applied below
# is based on stale dimensions and the window ends up visibly off-centre.
settle() {
    local prev cur i stable=0
    command -v jq >/dev/null 2>&1 || return 0
    prev=$(window_size) || return 0
    [[ -n $prev ]] || return 0
    for i in $(seq 1 30); do
        sleep 0.05
        cur=$(window_size)
        if [[ -n $cur && $cur == "$prev" ]]; then
            stable=$((stable + 1))
            (( stable >= 2 )) && return 0
        else
            stable=0
        fi
        prev=$cur
    done
    return 0
}

# show the parked window already in its final state: reveal it while
# transparent, wait for Ghostty to settle its grid, apply the final size and
# position, then remove the transparency. It therefore appears directly at its
# final geometry instead of visibly resizing twice.
show_focus() {
    local state i
    set_opacity hidden
    msgs "scratchpad show"
    settle
    msgs "resize set width ${WIDTH} px height ${HEIGHT} px, move position center"
    set_opacity visible
    for i in $(seq 1 12); do
        msgs "focus"
        state=$(window_state)
        [[ ${state##*$'\t'} == true ]] && break
        sleep 0.05
    done
    return 0
}

focus_only() {
    local state i
    for i in $(seq 1 12); do
        msgs "focus"
        state=$(window_state)
        [[ ${state##*$'\t'} == true ]] && return 0
        sleep 0.05
    done
    return 0
}

hide_menu() { msgs "move scratchpad"; }

toggle() {
    local state ws focused
    state=$(window_state) || state=""
    if [[ -z $state ]]; then
        # no jq (or a race): fall back to i3's own scratchpad toggle
        show_focus
        return 0
    fi
    ws=${state%%$'\t'*}
    focused=${state##*$'\t'}
    if [[ $ws == "__i3_scratch" ]]; then
        show_focus          # parked -> show
    elif [[ $focused == true ]]; then
        hide_menu           # up and focused -> hide
    else
        focus_only          # up but another window has focus -> just focus
    fi
}

command -v "$APP" >/dev/null 2>&1 || {
    note "bluetui is not installed" "$APP not found"
    exit 1
}

# No i3 (e.g. launched from a plain shell): run the menu in place.
if ! have_i3; then
    exec "$TERM_CMD" --class="$CLASS" --title="bluetooth" \
        --window-width=100 --window-height=28 \
        --window-padding-x=8 --window-padding-y=6 \
        --background-opacity=0.95 \
        --font-size=9 -e "$APP"
fi

# Already open (parked, visible, or visible and unfocused): act on its state.
if window_exists; then
    toggle
    exit 0
fi

"$TERM_CMD" \
    --class="$CLASS" \
    --title="bluetooth" \
    --window-width=100 \
    --window-height=28 \
    --window-padding-x=8 \
    --window-padding-y=6 \
    --background-opacity=0.95 \
    --font-size=9 \
    -e "$APP" >/dev/null 2>&1 &

# for_window parks the new window in the scratchpad, so wait for it to exist
# and then pull it onto the current workspace and focus it.
state=""
for _ in $(seq 1 100); do
    state=$(window_state) || state=""
    [[ -n $state ]] && break
    if ! command -v jq >/dev/null 2>&1 && window_exists; then
        sleep 0.1           # let the for_window rule park it first
        show_focus
        exit 0
    fi
    sleep 0.05
done

if [[ -n $state ]]; then
    sleep 0.1               # let the for_window rule park it first
    if [[ ${state%%$'\t'*} == "__i3_scratch" ]]; then
        show_focus
    else
        focus_only
    fi
    exit 0
fi

note "Could not open Bluetooth" "ghostty did not create a window"
exit 1
