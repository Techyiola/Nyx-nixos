_css_installed = False


def install_css() -> None:
    global _css_installed
    if _css_installed:
        return
    provider = Gtk.CssProvider()
    provider.load_from_data(EDITOR_CSS)
    screen = Gdk.Screen.get_default()
    if screen is not None:
        Gtk.StyleContext.add_provider_for_screen(
            screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )
    _css_installed = True


class Editor(Gtk.Window):
    def __init__(self, pixbuf: GdkPixbuf.Pixbuf, opts):
        super().__init__(title="Screenshot")
        self.opts = opts
        self.pixbuf = pixbuf
        self.base_surface = surface_for(pixbuf)
        self.img_w = pixbuf.get_width()
        self.img_h = pixbuf.get_height()
        self.shapes: list[dict] = []
        self.redo_stack: list[dict] = []
        self.current: dict | None = None
        self.tool = "arrow"
        self.color_name = "Red"
        self.color = hex_to_rgb(dict(COLORS)["Red"]) + (1.0,)
        self.width = 3
        self._sync = False
        self._busy = False
        self.text_popover: Gtk.Popover | None = None

        self.set_wmclass("screenshot-editor", "screenshot-editor")
        self.set_icon_name("camera-photo")
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_resizable(True)
        self.connect("key-press-event", self.on_key)
        self.connect("destroy", self.on_destroy)

        display = Gdk.Display.get_default()
        monitor = display.get_primary_monitor() if display else None
        geo = monitor.get_geometry() if monitor else None
        available_w = geo.width if geo else 1920
        available_h = geo.height if geo else 1080
        max_w = max(480, int(available_w * 0.86))
        max_h = max(320, int(available_h * 0.78))
        scale = min(1.0, max_w / self.img_w, max_h / self.img_h)
        disp_w = max(420, int(self.img_w * scale))
        disp_h = max(240, int(self.img_h * scale))
        self.set_default_size(max(620, disp_w + 20), disp_h + 92)

        self.build_ui()

    # -- UI ---------------------------------------------------------------
    def build_ui(self) -> None:
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        outer.pack_start(self.build_toolbar(), False, False, 0)

        canvas = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        canvas.get_style_context().add_class("canvas")
        canvas.set_border_width(10)
        self.area = Gtk.DrawingArea()
        self.area.set_size_request(420, 240)
        self.area.set_hexpand(True)
        self.area.set_vexpand(True)
        self.area.add_events(
            Gdk.EventMask.BUTTON_PRESS_MASK
            | Gdk.EventMask.BUTTON_RELEASE_MASK
            | Gdk.EventMask.POINTER_MOTION_MASK
        )
        self.area.connect("draw", self.on_area_draw)
        self.area.connect("button-press-event", self.on_area_press)
        self.area.connect("button-release-event", self.on_area_release)
        self.area.connect("motion-notify-event", self.on_area_motion)
        canvas.pack_start(self.area, True, True, 0)
        outer.pack_start(canvas, True, True, 0)

        footer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        footer.get_style_context().add_class("footer")
        self.hint = Gtk.Label(label=self.footer_text())
        self.hint.set_xalign(0)
        self.hint.set_hexpand(True)
        self.hint.set_ellipsize(Pango.EllipsizeMode.END)
        self.size_label = Gtk.Label(label=f"{self.img_w} × {self.img_h}")
        self.size_label.set_xalign(1)
        footer.pack_start(self.hint, True, True, 0)
        footer.pack_end(self.size_label, False, False, 0)
        outer.pack_start(footer, False, False, 0)

        self.add(outer)
        self.update_history_buttons()

    def build_toolbar(self) -> Gtk.Box:
        bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        bar.get_style_context().add_class("toolbar")

        self.tool_buttons: dict[str, Gtk.ToggleButton] = {}
        for key, glyph, label in TOOLS:
            button = Gtk.ToggleButton(label=glyph)
            button.set_relief(Gtk.ReliefStyle.NONE)
            button.set_tooltip_text(f"{label}  ({key.upper()})")
            button.get_style_context().add_class("tool")
            button.connect("toggled", self.on_tool_toggled, key)
            self.tool_buttons[key] = button
            bar.pack_start(button, False, False, 0)
        self.tool_buttons["arrow"].set_active(True)

        bar.pack_start(Gtk.Separator(orientation=Gtk.Orientation.VERTICAL), False, False, 6)

        self.swatches: dict[str, Gtk.DrawingArea] = {}
        for name, value in COLORS:
            button = Gtk.Button()
            button.set_relief(Gtk.ReliefStyle.NONE)
            button.set_tooltip_text(name)
            button.get_style_context().add_class("swatch")
            swatch = Gtk.DrawingArea()
            swatch.set_size_request(18, 18)
            swatch.connect("draw", self.on_swatch_draw, name)
            button.add(swatch)
            button.connect("clicked", self.on_color_clicked, name)
            self.swatches[name] = swatch
            bar.pack_start(button, False, False, 0)

        bar.pack_start(Gtk.Separator(orientation=Gtk.Orientation.VERTICAL), False, False, 6)

        width_label = Gtk.Label(label="Width")
        bar.pack_start(width_label, False, False, 0)
        self.width_combo = Gtk.ComboBoxText()
        for width in (2, 3, 5, 8, 12):
            self.width_combo.append(str(width), f"{width} px")
        self.width_combo.set_active_id("3")
        self.width_combo.set_tooltip_text("Stroke width")
        self.width_combo.connect("changed", self.on_width_changed)
        bar.pack_start(self.width_combo, False, False, 0)

        spacer = Gtk.Box()
        spacer.set_hexpand(True)
        bar.pack_start(spacer, True, True, 0)

        self.undo_button = Gtk.Button.new_from_icon_name("edit-undo-symbolic", Gtk.IconSize.BUTTON)
        self.undo_button.set_tooltip_text("Undo  (Ctrl+Z)")
        self.undo_button.connect("clicked", lambda *_: self.undo())
        bar.pack_start(self.undo_button, False, False, 0)

        self.redo_button = Gtk.Button.new_from_icon_name("edit-redo-symbolic", Gtk.IconSize.BUTTON)
        self.redo_button.set_tooltip_text("Redo  (Ctrl+Shift+Z)")
        self.redo_button.connect("clicked", lambda *_: self.redo())
        bar.pack_start(self.redo_button, False, False, 0)

        bar.pack_start(Gtk.Separator(orientation=Gtk.Orientation.VERTICAL), False, False, 6)

        cancel = Gtk.Button(label="Cancel")
        cancel.set_tooltip_text("Discard  (Esc)")
        cancel.connect("clicked", lambda *_: self.discard())
        bar.pack_start(cancel, False, False, 0)

        copy = Gtk.Button(label="Copy")
        copy.set_tooltip_text("Copy to clipboard  (Ctrl+C)")
        copy.connect("clicked", lambda *_: self.action_copy())
        bar.pack_start(copy, False, False, 0)

        save = Gtk.Button(label="Save")
        save.set_tooltip_text("Save to ~/Pictures/Screenshots  (Ctrl+S)")
        save.connect("clicked", lambda *_: self.action_save())
        bar.pack_start(save, False, False, 0)

        both = Gtk.Button(label="Copy & Save")
        both.set_tooltip_text("Copy and save  (Enter)")
        both.get_style_context().add_class("primary")
        both.connect("clicked", lambda *_: self.action_both())
        bar.pack_start(both, False, False, 0)

        return bar

    # -- toolbar callbacks ------------------------------------------------
    def on_tool_toggled(self, button: Gtk.ToggleButton, key: str) -> None:
        if self._sync:
            return
        if not button.get_active():
            if self.tool == key:
                self._sync = True
                button.set_active(True)
                self._sync = False
            return
        self._sync = True
        self.tool = key
        self.current = None
        for other_key, other in self.tool_buttons.items():
            if other_key != key:
                other.set_active(False)
        self._sync = False
        if getattr(self, "area", None) is not None:
            self.area.queue_draw()
        self.update_hint()

    def footer_text(self) -> str:
        return f"{TOOL_HINTS.get(self.tool, 'Drag to draw')}   ·   {SHORTCUT_HINT}"

    def update_hint(self) -> None:
        hint = getattr(self, "hint", None)
        if hint is not None:
            hint.set_text(self.footer_text())

    def on_swatch_draw(self, widget: Gtk.DrawingArea, cr, name: str):
        alloc = widget.get_allocation()
        cr.set_source_rgba(0, 0, 0, 0)
        cr.paint()
        selected = name == self.color_name
        inset = 3 if selected else 1
        if selected:
            cr.set_source_rgb(*hex_to_rgb(FG))
            rounded_rect(cr, 0.5, 0.5, alloc.width - 1, alloc.height - 1, 3)
            cr.fill()
        value = dict(COLORS)[name]
        cr.set_source_rgb(*hex_to_rgb(value))
        rounded_rect(cr, inset, inset, alloc.width - inset * 2, alloc.height - inset * 2, 2)
        cr.fill()
        cr.set_source_rgba(0.16, 0.16, 0.16, 1)
        cr.set_line_width(1)
        rounded_rect(cr, inset + 0.5, inset + 0.5, alloc.width - inset * 2 - 1, alloc.height - inset * 2 - 1, 2)
        cr.stroke()
        return False

    def on_color_clicked(self, _button, name: str) -> None:
        self.color_name = name
        self.color = hex_to_rgb(dict(COLORS)[name]) + (1.0,)
        for swatch in self.swatches.values():
            swatch.queue_draw()

    def on_width_changed(self, combo: Gtk.ComboBoxText) -> None:
        active = combo.get_active_id()
        if active:
            self.width = int(active)

    # -- history ----------------------------------------------------------
    def update_history_buttons(self) -> None:
        self.undo_button.set_sensitive(bool(self.shapes))
        self.redo_button.set_sensitive(bool(self.redo_stack))

    def undo(self) -> None:
        if not self.shapes:
            return
        self.redo_stack.append(self.shapes.pop())
        self.update_history_buttons()
        self.area.queue_draw()

    def redo(self) -> None:
        if not self.redo_stack:
            return
        self.shapes.append(self.redo_stack.pop())
        self.update_history_buttons()
        self.area.queue_draw()

    def add_shape(self, shape: dict) -> None:
        self.shapes.append(shape)
        self.redo_stack.clear()
        self.update_history_buttons()
        self.area.queue_draw()

    # -- view transform ---------------------------------------------------
    def view_transform(self, aw: int, ah: int):
        if aw <= 0 or ah <= 0:
            return 1.0, 0.0, 0.0
        scale = min(1.0, aw / self.img_w, ah / self.img_h)
        ox = (aw - self.img_w * scale) / 2.0
        oy = (ah - self.img_h * scale) / 2.0
        return scale, ox, oy

    def to_image(self, x: float, y: float):
        aw = self.area.get_allocated_width()
        ah = self.area.get_allocated_height()
        scale, ox, oy = self.view_transform(aw, ah)
        ix = (x - ox) / scale
        iy = (y - oy) / scale
        if ix < 0 or iy < 0 or ix > self.img_w or iy > self.img_h:
            return None
        return max(0.0, min(ix, self.img_w - 1)), max(0.0, min(iy, self.img_h - 1))

    # -- canvas painting --------------------------------------------------
    def on_area_draw(self, widget: Gtk.DrawingArea, cr):
        aw = widget.get_allocated_width()
        ah = widget.get_allocated_height()
        cr.set_source_rgb(0.03, 0.03, 0.03)
        cr.paint()

        scale, ox, oy = self.view_transform(aw, ah)
        cr.save()
        cr.translate(ox, oy)
        cr.scale(scale, scale)
        cr.set_source_surface(self.base_surface, 0, 0)
        cr.get_source().set_filter(cairo.FILTER_GOOD)
        cr.paint()
        for shape in self.shapes:
            draw_shape(cr, shape, self.base_surface)
        if self.current is not None:
            draw_shape(cr, self.current, self.base_surface)
        cr.restore()

        cr.set_source_rgba(0.16, 0.16, 0.16, 1)
        cr.set_line_width(1)
        cr.rectangle(ox - 0.5, oy - 0.5, self.img_w * scale + 1, self.img_h * scale + 1)
        cr.stroke()
        return False

    # -- canvas interaction ----------------------------------------------
    def on_area_press(self, _widget, event):
        if event.button == 3:
            if self.current is not None:
                self.current = None
                self.area.queue_draw()
            return True
        if event.button != 1:
            return False
        point = self.to_image(event.x, event.y)
        if point is None:
            return False
        ix, iy = point

        if self.tool == "text":
            self.open_text_popover(int(event.x), int(event.y), ix, iy)
            return True

        base = {
            "type": self.tool,
            "color": self.color,
            "width": self.width,
            "x1": ix,
            "y1": iy,
            "x2": ix,
            "y2": iy,
        }
        if self.tool == "pen":
            base = {
                "type": "pen",
                "color": self.color,
                "width": self.width,
                "points": [(ix, iy)],
            }
        self.current = base
        self.area.queue_draw()
        return True

    def on_area_motion(self, _widget, event):
        if self.current is None:
            return False
        point = self.to_image(event.x, event.y)
        if point is None:
            return False
        ix, iy = point
        shift = bool(event.state & Gdk.ModifierType.SHIFT_MASK)

        if self.current["type"] == "pen":
            last = self.current["points"][-1]
            if math.hypot(ix - last[0], iy - last[1]) >= 1.0:
                self.current["points"].append((ix, iy))
        else:
            x1, y1 = self.current["x1"], self.current["y1"]
            if shift:
                dx, dy = ix - x1, iy - y1
                if self.current["type"] == "arrow":
                    angle = math.atan2(dy, dx)
                    snapped = round(angle / (math.pi / 4)) * (math.pi / 4)
                    distance = math.hypot(dx, dy)
                    ix = x1 + math.cos(snapped) * distance
                    iy = y1 + math.sin(snapped) * distance
                else:
                    side = max(abs(dx), abs(dy))
                    ix = x1 + (side if dx >= 0 else -side)
                    iy = y1 + (side if dy >= 0 else -side)
            self.current["x2"] = ix
            self.current["y2"] = iy
        self.area.queue_draw()
        return True

    def on_area_release(self, _widget, event):
        if event.button != 1 or self.current is None:
            return False
        shape = self.current
        self.current = None
        kind = shape["type"]
        if kind == "pen":
            valid = len(shape["points"]) >= 2
        elif kind == "arrow":
            valid = math.hypot(shape["x2"] - shape["x1"], shape["y2"] - shape["y1"]) >= 4
        else:
            valid = abs(shape["x2"] - shape["x1"]) >= 3 and abs(shape["y2"] - shape["y1"]) >= 3
        if valid:
            self.add_shape(shape)
        self.area.queue_draw()
        return True

    # -- text -------------------------------------------------------------
    def open_text_popover(self, screen_x: int, screen_y: int, ix: float, iy: float) -> None:
        if self.text_popover is not None:
            self.text_popover.popdown()
            self.text_popover = None

        popover = Gtk.Popover.new(self.area)
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        box.set_border_width(6)
        entry = Gtk.Entry()
        entry.set_placeholder_text("Text…")
        entry.set_width_chars(24)
        add = Gtk.Button(label="Add")
        add.get_style_context().add_class("primary")
        box.pack_start(entry, True, True, 0)
        box.pack_start(add, False, False, 0)
        popover.add(box)

        def commit(*_args):
            text = entry.get_text().strip()
            if text:
                self.add_shape(
                    {
                        "type": "text",
                        "text": text,
                        "x": ix,
                        "y": iy,
                        "size": 18 + self.width * 2,
                        "color": self.color,
                    }
                )
            popover.popdown()

        def on_entry_key(_entry, event):
            if event.keyval == Gdk.KEY_Escape:
                popover.popdown()
                return True
            return False

        entry.connect("activate", commit)
        entry.connect("key-press-event", on_entry_key)
        add.connect("clicked", commit)

        def closed(*_args):
            if self.text_popover is popover:
                self.text_popover = None

        popover.connect("closed", closed)
        rect = Gdk.Rectangle()
        rect.x, rect.y, rect.width, rect.height = screen_x, screen_y, 1, 1
        popover.set_pointing_to(rect)
        popover.show_all()
        popover.popup()
        entry.grab_focus()
        self.text_popover = popover

    # -- keyboard ---------------------------------------------------------
    def on_key(self, _widget, event):
        if self.text_popover is not None and self.text_popover.get_visible():
            return False
        key = Gdk.keyval_name(event.keyval) or ""
        lower = key.lower()
        ctrl = bool(event.state & Gdk.ModifierType.CONTROL_MASK)
        shift = bool(event.state & Gdk.ModifierType.SHIFT_MASK)

        if key == "Escape":
            self.discard()
            return True
        if key in ("Return", "KP_Enter") and not ctrl:
            self.action_both()
            return True
        if ctrl and lower == "c":
            self.action_copy()
            return True
        if ctrl and lower == "s":
            if shift:
                self.action_both()
            else:
                self.action_save()
            return True
        if ctrl and lower == "z":
            self.redo() if shift else self.undo()
            return True
        if ctrl and lower == "y":
            self.redo()
            return True
        if not ctrl and not shift and lower in ("a", "r", "o", "p", "t", "b"):
            tool = {
                "a": "arrow",
                "r": "rect",
                "o": "ellipse",
                "p": "pen",
                "t": "text",
                "b": "pixelate",
            }[lower]
            button = self.tool_buttons[tool]
            button.set_active(True)
            return True
        return False

    # -- export / actions -------------------------------------------------
    def export_png(self, path: str) -> None:
        surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, self.img_w, self.img_h)
        cr = cairo.Context(surface)
        cr.set_source_surface(self.base_surface, 0, 0)
        cr.paint()
        for shape in self.shapes:
            draw_shape(cr, shape, self.base_surface)
        surface.write_to_png(path)
        surface.flush()

    def dimensions(self) -> str:
        return f"{self.img_w} × {self.img_h}"

    def discard(self) -> None:
        self.destroy()

    def action_copy(self) -> None:
        if self._busy:
            return
        self._busy = True
        path = temp_png()
        try:
            self.export_png(path)
        except Exception as exc:
            self._busy = False
            _unlink_quietly(path)
            notify("Could not render screenshot", str(exc), icon="dialog-error", urgency="critical")
            return
        if copy_to_clipboard(path):
            notify("Copied to clipboard", self.dimensions(), icon="edit-copy")
            self.destroy()
        else:
            self._busy = False
            _unlink_quietly(path)
            notify(
                "Could not copy to clipboard",
                "The clipboard helper is not running.",
                icon="dialog-error",
                urgency="critical",
            )

    def action_save(self) -> None:
        if self._busy:
            return
        self._busy = True
        path = resolve_save_path(self.opts)
        try:
            os.makedirs(os.path.dirname(path), mode=0o755, exist_ok=True)
            self.export_png(path)
        except Exception as exc:
            self._busy = False
            notify("Could not save screenshot", str(exc), icon="dialog-error", urgency="critical")
            return
        notify("Screenshot saved", path, icon=path)
        self.destroy()

    def action_both(self) -> None:
        if self._busy:
            return
        self._busy = True
        path = resolve_save_path(self.opts)
        try:
            os.makedirs(os.path.dirname(path), mode=0o755, exist_ok=True)
            self.export_png(path)
        except Exception as exc:
            self._busy = False
            notify("Could not save screenshot", str(exc), icon="dialog-error", urgency="critical")
            return
        if copy_to_clipboard(path):
            notify("Saved & copied", path, icon=path)
        else:
            notify("Screenshot saved", path + "\n(clipboard unavailable)", icon=path)
        self.destroy()

    def on_destroy(self, *_args):
        Gtk.main_quit()


def run_editor(pixbuf: GdkPixbuf.Pixbuf, opts) -> None:
    install_css()
    editor = Editor(pixbuf, opts)
    editor.show_all()
    editor.present()
    Gtk.main()


# ---------------------------------------------------------------------------
# Non-interactive actions
# ---------------------------------------------------------------------------


def save_pixbuf(pixbuf: GdkPixbuf.Pixbuf, path: str) -> None:
    os.makedirs(os.path.dirname(os.path.abspath(path)), mode=0o755, exist_ok=True)
    pixbuf.savev(os.path.abspath(path), "png", [], [])


def copy_pixbuf(pixbuf: GdkPixbuf.Pixbuf) -> bool:
    path = temp_png()
    try:
        pixbuf.savev(path, "png", [], [])
    except Exception as exc:
        log(f"copy pixbuf: {exc}")
        _unlink_quietly(path)
        return False
    if copy_to_clipboard(path):
        return True
    _unlink_quietly(path)
    return False


def _unlink_quietly(path: str) -> None:
    try:
        os.unlink(path)
    except OSError:
        pass


def apply_actions(pixbuf: GdkPixbuf.Pixbuf, mode: str, opts) -> int:
    do_copy = opts.copy
    do_save = opts.save or bool(opts.path)
    if not do_copy and not do_save:
        if mode in ("full",):
            do_copy = True
        elif mode in ("save",):
            do_copy = do_save = True
        else:
            do_copy = True

    saved: str | None = None
    if do_save:
        saved = resolve_save_path(opts)
        try:
            save_pixbuf(pixbuf, saved)
        except Exception as exc:
            return fail("Could not save screenshot", str(exc))

    copied = copy_pixbuf(pixbuf) if do_copy else False

    if saved and copied:
        notify("Saved & copied", saved, icon=saved)
    elif saved and do_copy:
        notify("Screenshot saved", saved + "\n(clipboard unavailable)", icon=saved)
    elif saved:
        notify("Screenshot saved", saved, icon=saved)
    elif copied:
        notify("Copied to clipboard", f"{pixbuf.get_width()} × {pixbuf.get_height()}", icon="edit-copy")
    else:
        return fail("Could not copy screenshot", "The clipboard helper is unavailable.")
    return 0


# ---------------------------------------------------------------------------
# Modes
# ---------------------------------------------------------------------------


def parse_rect(value: str) -> tuple[int, int, int, int]:
    parts = [p.strip() for p in value.replace("x", ",").split(",")]
    if len(parts) != 4:
        raise argparse.ArgumentTypeError("expected X,Y,W,H")
    try:
        return tuple(int(p) for p in parts)  # type: ignore[return-value]
    except ValueError as exc:
        raise argparse.ArgumentTypeError("X,Y,W,H must be integers") from exc


def acquire_lock():
    path = os.path.join(runtime_dir(), "screenshot.lock")
    fd = os.open(path, os.O_CREAT | os.O_RDWR, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        os.close(fd)
        return None
    os.ftruncate(fd, 0)
    os.write(fd, str(os.getpid()).encode("ascii"))
    return fd


def run_mode(opts) -> int:
    if opts.delay > 0:
        time.sleep(opts.delay)

    try:
        if opts.mode == "window":
            pixbuf = capture_window_pixbuf()
        elif opts.rect:
            root = capture_root_pixbuf()
            pixbuf = crop_pixbuf(root, *opts.rect)
        else:
            root = capture_root_pixbuf()
            if opts.mode == "region":
                rect = RegionSelector.select(root)
                if rect is None:
                    return 0
                pixbuf = crop_pixbuf(root, *rect)
            else:
                pixbuf = root
    except Exception as exc:
        return fail("Could not capture the screen", str(exc))

    wants_editor = opts.edit or (opts.mode in ("region", "window") and not opts.no_edit)
    if wants_editor:
        run_editor(pixbuf, opts)
        return 0
    return apply_actions(pixbuf, opts.mode, opts)


def menu() -> int:
    if not shutil.which("rofi"):
        return fail("The screenshot menu needs rofi", "Install rofi or use the Print keys directly.")
    entries = [
        ("Region  ·  select & annotate", ["region"]),
        ("Window  ·  capture focused & annotate", ["window"]),
        ("Full screen  ·  copy to clipboard", ["full"]),
        ("Full screen  ·  save & copy", ["save"]),
        ("Region  ·  3 second delay", ["region", "--delay", "3"]),
        ("Open screenshots folder", None),
    ]
    text = "\n".join(label for label, _ in entries)
    try:
        proc = subprocess.run(
            ["rofi", "-dmenu", "-i", "-no-custom", "-p", "Screenshot", "-mesg", "Capture · annotate · copy"],
            input=text,
            text=True,
            capture_output=True,
        )
    except OSError as exc:
        return fail("Could not open the screenshot menu", str(exc))
    if proc.returncode != 0:
        return 0
    choice = proc.stdout.strip()
    for label, args in entries:
        if label == choice:
            if args is None:
                folder = pictures_dir()
                os.makedirs(folder, mode=0o755, exist_ok=True)
                subprocess.Popen(["xdg-open", folder], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                return 0
            subprocess.Popen(
                [sys.executable, os.path.abspath(__file__), *args],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
            return 0
    return 0


def doctor() -> int:
    fifo, _ = _clip_paths()
    rows = [
        ("display", os.environ.get("DISPLAY") or "not set"),
        ("session", os.environ.get("XDG_SESSION_TYPE") or "unknown"),
        ("ImageMagick import", shutil.which("import") or "MISSING"),
        ("GTK 3 / PyGObject", "ok"),
        ("python-cairo", cairo.version),
        ("notifications", shutil.which("notify-send") or "missing (optional)"),
        ("clipboard helper", f"{'running' if _clip_alive() else 'stopped'}  ({fifo})"),
        ("i3", shutil.which("i3-msg") or "missing (optional)"),
        ("rofi", shutil.which("rofi") or "missing (optional)"),
        ("save folder", pictures_dir()),
    ]
    width = max(len(label) for label, _ in rows) + 2
    print(f"screenshot {APP_VERSION}")
    print()
    for label, value in rows:
        print(f"  {label:<{width}} {value}")
    print()
    ok = bool(shutil.which("import")) and os.environ.get("DISPLAY")
    print("ready" if ok else "not ready — install ImageMagick and run inside X11")
    return 0 if ok else 1


# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="screenshot",
        description="Capture, annotate, copy and save screenshots on X11/i3.",
        epilog="Keybindings: Print = region, Shift+Print = full→clipboard, "
               "Super+Print = full→save, Super+Shift+S = menu.",
    )
    parser.add_argument(
        "mode",
        nargs="?",
        default="region",
        choices=("region", "window", "full", "save", "menu"),
        help="capture mode (default: region)",
    )
    parser.add_argument("--delay", type=float, default=0.0, metavar="SECONDS",
                        help="wait before capturing (useful for menus/tooltips)")
    parser.add_argument("--no-edit", action="store_true",
                        help="skip the annotation editor for region/window captures")
    parser.add_argument("--edit", action="store_true",
                        help="open the annotation editor even for full/save captures")
    parser.add_argument("--copy", action="store_true",
                        help="copy the result to the clipboard (non-editor modes)")
    parser.add_argument("--save", action="store_true",
                        help="save the result (non-editor modes)")
    parser.add_argument("--path", metavar="PATH",
                        help="save to PATH (or into PATH/ if it is a directory)")
    parser.add_argument("--rect", type=parse_rect, metavar="X,Y,W,H",
                        help="capture this rectangle instead of asking (region mode)")
    parser.add_argument("--doctor", action="store_true", help="check dependencies and exit")
    parser.add_argument("--version", action="version", version=f"%(prog)s {APP_VERSION}")
    parser.add_argument("--clipboard-daemon", action="store_true", help=argparse.SUPPRESS)
    return parser.parse_args(argv)


def main(argv: list[str]) -> int:
    opts = parse_args(argv)
    if opts.clipboard_daemon:
        return clipboard_daemon()
    if opts.doctor:
        return doctor()
    if opts.mode == "menu":
        return menu()
    if not os.environ.get("DISPLAY"):
        return fail("No X11 display found", "This tool is for the X11/i3 session.")

    lock = acquire_lock()
    if lock is None:
        notify("Screenshot already in progress", "Finish or cancel the open grab first.", icon="dialog-information")
        return 0
    try:
        return run_mode(opts)
    except KeyboardInterrupt:
        return 130
    finally:
        try:
            fcntl.flock(lock, fcntl.LOCK_UN)
            os.close(lock)
        except OSError:
            pass


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
