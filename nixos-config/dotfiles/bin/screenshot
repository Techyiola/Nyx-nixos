#!/usr/bin/env python3
"""
screenshot — a small, monochrome screenshot utility for the i3 rice.

Why this exists
---------------
The i3 config has always had the three Print-key bindings, but the script they
call did not.  This is that script, with the rest of the workflow filled in:

    screenshot region      select an area, annotate it, copy and/or save
    screenshot window      capture the focused window, then annotate
    screenshot full        grab the whole screen straight to the clipboard
    screenshot save        grab the whole screen, save it and copy it
    screenshot menu        rofi menu with all of the above (+ delayed capture)

The selector and editor are plain GTK 3 + Cairo, so they follow the rice's
palette (#0D0D0D / #C8C8C8 / #2A2A2A) instead of dragging in another toolkit.
ImageMagick's `import` is used for the actual X11 grab.  Clipboard images are
served by a tiny long-lived helper (the same trick `xclip` uses) so they stay
pasteable after this process exits.  Notifications go through dunst.

Handy details
-------------
* The screen is captured *before* the selector is shown, so the overlay can
  never end up in the screenshot.
* Hold Shift while dragging to constrain a box to a square, or an arrow to
  45-degree increments.
* In the editor: A/R/O/P/T/B select tools, Ctrl+Z undo, Ctrl+Shift+Z redo,
  Ctrl+C copy, Ctrl+S save, Enter copy & save, Esc discard.
* Saved files land in ~/Pictures/Screenshots unless SCREENSHOT_DIR is set.

Diagnostics:  screenshot --doctor
"""

from __future__ import annotations

import argparse
import fcntl
import json
import math
import os
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import threading
import time
import warnings

# GTK 3's set_wmclass is the only portable way to pick a stable i3 match
# class; the deprecation noise is not useful here.
warnings.filterwarnings(
    "ignore", category=DeprecationWarning, message=r"Gtk\.Window\.set_wmclass is deprecated"
)

APP_NAME = "Screenshots"
APP_VERSION = "1.0"

# Match the rest of the rice.
BG = "#0D0D0D"
BG_ALT = "#121212"
FG = "#F0F0F0"
FG_DIM = "#9A9A9A"
ACCENT = "#C8C8C8"
BORDER = "#2A2A2A"

TOOLS = (
    ("arrow", "↗", "Arrow"),
    ("rect", "▭", "Rectangle"),
    ("ellipse", "◯", "Ellipse"),
    ("pen", "✎", "Pen"),
    ("text", "T", "Text"),
    ("pixelate", "▦", "Pixelate / redact"),
)

TOOL_HINTS = {
    "arrow": "Drag to draw an arrow",
    "rect": "Drag to draw a rectangle",
    "ellipse": "Drag to draw an ellipse",
    "pen": "Drag to draw freehand",
    "text": "Click to place text",
    "pixelate": "Drag over an area to pixelate it",
}

SHORTCUT_HINT = "Ctrl+Z undo  ·  Ctrl+C copy  ·  Ctrl+S save  ·  Enter copy & save  ·  Esc discard"

COLORS = (
    ("Red", "#E5484D"),
    ("White", "#F0F0F0"),
    ("Yellow", "#F5C542"),
    ("Green", "#46A758"),
    ("Blue", "#4C8DFF"),
    ("Black", "#0D0D0D"),
)

try:
    import gi

    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    gi.require_version("GdkPixbuf", "2.0")
    gi.require_version("Pango", "1.0")
    gi.require_version("PangoCairo", "1.0")
    from gi.repository import Gdk, GdkPixbuf, GLib, Gtk, Pango, PangoCairo

    import cairo
except Exception as exc:  # pragma: no cover - only on a broken install
    sys.stderr.write(
        "screenshot: GTK 3, PyGObject and python-cairo are required.\n"
        f"  {exc}\n"
        "  On Arch/CachyOS: sudo pacman -S python-gobject gtk3 python-cairo\n"
    )
    raise SystemExit(2)


# ---------------------------------------------------------------------------
# small helpers
# ---------------------------------------------------------------------------


def runtime_dir() -> str:
    base = os.environ.get("XDG_RUNTIME_DIR") or os.path.join(
        tempfile.gettempdir(), f"screenshot-{os.getuid()}"
    )
    path = os.path.join(base, "screenshot")
    os.makedirs(path, mode=0o700, exist_ok=True)
    return path


def log(message: str) -> None:
    try:
        with open(os.path.join(runtime_dir(), "screenshot.log"), "a", encoding="utf-8") as fh:
            fh.write(f"{time.strftime('%Y-%m-%d %H:%M:%S')} {message}\n")
    except OSError:
        pass


def notify(summary: str, body: str = "", icon: str | None = None, urgency: str = "normal") -> None:
    if not shutil.which("notify-send"):
        return
    cmd = [
        "notify-send",
        "-a",
        APP_NAME,
        "-u",
        urgency,
        "-t",
        "5000",
        "-h",
        "string:x-canonical-private-synchronous:screenshot",
    ]
    if icon:
        cmd += ["-i", icon]
    cmd.append(summary)
    if body:
        cmd.append(body)
    try:
        subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass


def fail(message: str, detail: str = "") -> int:
    log(f"error: {message} {detail}".strip())
    sys.stderr.write(f"screenshot: {message}\n")
    if detail:
        sys.stderr.write(f"  {detail}\n")
    notify("Screenshot failed", message + (f"\n{detail}" if detail else ""), icon="dialog-error", urgency="critical")
    return 1


def pictures_dir() -> str:
    override = os.environ.get("SCREENSHOT_DIR")
    if override:
        return os.path.abspath(os.path.expanduser(override))
    try:
        out = subprocess.check_output(["xdg-user-dir", "PICTURES"], text=True, stderr=subprocess.DEVNULL).strip()
    except Exception:
        out = ""
    if not out or out == os.path.expanduser("~"):
        out = os.path.join(os.path.expanduser("~"), "Pictures")
    return os.path.join(out, "Screenshots")


def unique_path(directory: str, prefix: str = "Screenshot") -> str:
    os.makedirs(directory, mode=0o755, exist_ok=True)
    stamp = time.strftime("%Y-%m-%d_%H-%M-%S")
    base = f"{prefix}_{stamp}"
    path = os.path.join(directory, base + ".png")
    n = 2
    while os.path.exists(path):
        path = os.path.join(directory, f"{base}_{n}.png")
        n += 1
    return path


def resolve_save_path(opts) -> str:
    """Turn --path (file or directory) into a concrete, absolute PNG path."""
    if not opts.path:
        return unique_path(pictures_dir())
    path = os.path.abspath(os.path.expanduser(opts.path))
    if opts.path.endswith(os.sep) or os.path.isdir(path):
        return unique_path(path)
    return path


def temp_png(prefix: str = "tmp-") -> str:
    fd, path = tempfile.mkstemp(prefix=prefix, suffix=".png", dir=runtime_dir())
    os.close(fd)
    return path


def hex_to_rgb(value: str) -> tuple[float, float, float]:
    value = value.lstrip("#")
    if len(value) == 3:
        value = "".join(c * 2 for c in value)
    return tuple(int(value[i : i + 2], 16) / 255.0 for i in (0, 2, 4))


def rounded_rect(cr, x: float, y: float, w: float, h: float, r: float) -> None:
    r = max(0.0, min(r, w / 2.0, h / 2.0))
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    cr.close_path()


def draw_label(cr, text: str, x: float, y: float, *, size: int = 10, color: str = FG,
               bold: bool = False, box: bool = False, padding: int = 7) -> tuple[int, int]:
    """Draw a Pango label; optionally put it on a rounded dark chip."""
    desc = Pango.FontDescription(f"JetBrainsMono Nerd Font {'Bold ' if bold else ''}{size}")
    layout = PangoCairo.create_layout(cr)
    layout.set_font_description(desc)
    layout.set_text(text, -1)
    tw, th = layout.get_pixel_size()
    if box:
        bx, by = x - padding, y - padding
        bw, bh = tw + padding * 2, th + padding * 2
        cr.set_source_rgba(0.05, 0.05, 0.05, 0.88)
        rounded_rect(cr, bx, by, bw, bh, 4)
        cr.fill()
        cr.set_source_rgba(0.16, 0.16, 0.16, 1)
        cr.set_line_width(1)
        rounded_rect(cr, bx + 0.5, by + 0.5, bw - 1, bh - 1, 4)
        cr.stroke()
    cr.set_source_rgb(*hex_to_rgb(color))
    cr.move_to(x, y)
    PangoCairo.show_layout(cr, layout)
    return tw, th


# ---------------------------------------------------------------------------
# X11 capture
# ---------------------------------------------------------------------------


def capture_root_pixbuf() -> GdkPixbuf.Pixbuf:
    path = os.path.join(runtime_dir(), "capture-root.png")
    proc = subprocess.run(
        ["import", "-quiet", "-silent", "-window", "root", path],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.PIPE,
        text=True,
    )
    if proc.returncode != 0 or not os.path.exists(path):
        raise RuntimeError(proc.stderr.strip() or "ImageMagick could not capture the screen")
    try:
        return GdkPixbuf.Pixbuf.new_from_file(path)
    finally:
        # The pixels are in the pixbuf now, so drop the temporary PNG.
        try:
            os.unlink(path)
        except OSError:
            pass


def _walk_i3(node: dict):
    if node.get("focused") and node.get("window"):
        return node
    for key in ("nodes", "floating_nodes"):
        for child in node.get(key) or []:
            found = _walk_i3(child)
            if found:
                return found
    return None


def focused_window_info() -> dict | None:
    if shutil.which("i3-msg"):
        try:
            tree = json.loads(
                subprocess.check_output(["i3-msg", "-t", "get_tree"], text=True, timeout=3)
            )
            node = _walk_i3(tree)
            if node:
                return node
        except Exception:
            pass

    if shutil.which("xprop"):
        try:
            out = subprocess.check_output(["xprop", "-root", "_NET_ACTIVE_WINDOW"], text=True, timeout=3)
            match = re.search(r"#\s*(0x[0-9a-fA-F]+|\d+)", out)
            if match:
                return {"window": int(match.group(1), 0), "name": "focused window"}
        except Exception:
            pass
    return None


def capture_window_pixbuf() -> GdkPixbuf.Pixbuf:
    info = focused_window_info()
    if not info:
        raise RuntimeError("No focused window was found")
    path = os.path.join(runtime_dir(), "capture-window.png")
    proc = subprocess.run(
        ["import", "-quiet", "-silent", "-window", str(info["window"]), path],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.PIPE,
        text=True,
    )
    if proc.returncode == 0 and os.path.exists(path):
        try:
            return GdkPixbuf.Pixbuf.new_from_file(path)
        finally:
            try:
                os.unlink(path)
            except OSError:
                pass
    # Fallback for a window ImageMagick cannot grab directly: take the screen
    # and crop to i3's geometry for the focused container.
    rect = info.get("rect") or {}
    if all(k in rect for k in ("x", "y", "width", "height")):
        root = capture_root_pixbuf()
        return crop_pixbuf(root, rect["x"], rect["y"], rect["width"], rect["height"])
    raise RuntimeError(proc.stderr.strip() or "ImageMagick could not capture the focused window")


def crop_pixbuf(pixbuf: GdkPixbuf.Pixbuf, x: int, y: int, w: int, h: int) -> GdkPixbuf.Pixbuf:
    iw, ih = pixbuf.get_width(), pixbuf.get_height()
    x = max(0, min(int(x), iw - 1))
    y = max(0, min(int(y), ih - 1))
    w = max(1, min(int(w), iw - x))
    h = max(1, min(int(h), ih - y))
    return pixbuf.new_subpixbuf(x, y, w, h).copy()


def surface_for(pixbuf: GdkPixbuf.Pixbuf):
    return Gdk.cairo_surface_create_from_pixbuf(pixbuf, 1, None)


# ---------------------------------------------------------------------------
# Clipboard helper (a tiny persistent owner, like xclip)
# ---------------------------------------------------------------------------


def _clip_paths() -> tuple[str, str]:
    d = runtime_dir()
    return os.path.join(d, "clipboard.fifo"), os.path.join(d, "clipboard.pid")


def _clip_alive() -> bool:
    fifo, pidfile = _clip_paths()
    if not (os.path.exists(fifo) and os.path.exists(pidfile)):
        return False
    try:
        pid = int(open(pidfile, encoding="utf-8").read().strip())
        os.kill(pid, 0)
    except Exception:
        return False
    # Guard against PID reuse: the owner must still be our daemon.
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as fh:
            cmdline = fh.read().replace(b"\0", b" ").decode("utf-8", "replace")
    except OSError:
        return True
    return "screenshot" in cmdline and "--clipboard-daemon" in cmdline


def _start_clip_daemon() -> None:
    # The daemon creates the fifo and pidfile itself, under a lock, so two
    # simultaneous "copy" actions can never end up with two owners.
    subprocess.Popen(
        [sys.executable, os.path.abspath(__file__), "--clipboard-daemon"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
        close_fds=True,
    )
    for _ in range(40):
        if _clip_alive():
            return
        time.sleep(0.05)
    raise RuntimeError("clipboard helper did not start")


def copy_to_clipboard(path: str) -> bool:
    """Send an image path to the clipboard owner.  Returns False on failure."""
    if not _clip_alive():
        try:
            _start_clip_daemon()
        except Exception as exc:
            log(f"clipboard daemon: {exc}")
            return _fallback_clipboard(path)
    fifo, _ = _clip_paths()
    try:
        fd = os.open(fifo, os.O_RDWR | os.O_NONBLOCK)
        try:
            os.write(fd, (path + "\n").encode("utf-8"))
        finally:
            os.close(fd)
        return True
    except OSError as exc:
        log(f"clipboard write: {exc}")
        try:
            _start_clip_daemon()
            fd = os.open(fifo, os.O_RDWR | os.O_NONBLOCK)
            try:
                os.write(fd, (path + "\n").encode("utf-8"))
            finally:
                os.close(fd)
            return True
        except Exception as exc2:
            log(f"clipboard retry: {exc2}")
            return _fallback_clipboard(path)


def _fallback_clipboard(path: str) -> bool:
    if shutil.which("xclip"):
        return subprocess.run(
            ["xclip", "-selection", "clipboard", "-t", "image/png", "-i", path],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        ).returncode == 0
    if shutil.which("wl-copy"):
        with open(path, "rb") as fh:
            return subprocess.run(
                ["wl-copy", "--type", "image/png"],
                stdin=fh,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            ).returncode == 0
    return False


def clipboard_daemon() -> int:
    Gtk.init([])
    fifo, pidfile = _clip_paths()

    # Single instance: i3 may exec this at login and again on every reload.
    lock_path = os.path.join(runtime_dir(), "clipboard.lock")
    lock_fd = os.open(lock_path, os.O_CREAT | os.O_RDWR, 0o600)
    try:
        fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        os.close(lock_fd)
        return 0

    # We own the clipboard now: replace any stale fifo/pidfile left by a
    # previous session.
    for path in (fifo, pidfile):
        try:
            os.unlink(path)
        except OSError:
            pass
    os.mkfifo(fifo, 0o600)

    clipboard = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
    state: dict[str, object] = {"pixbuf": None}

    def serve(path: str) -> bool:
        try:
            pixbuf = GdkPixbuf.Pixbuf.new_from_file(path)
            state["pixbuf"] = pixbuf
            clipboard.set_image(pixbuf)
            # A copy-only screenshot is a throwaway file; the daemon has the
            # pixels now, so clean it up.  Saved screenshots are left alone.
            if os.path.basename(path).startswith("tmp-"):
                try:
                    os.unlink(path)
                except OSError:
                    pass
        except Exception as exc:
            log(f"clipboard load {path}: {exc}")
        return False

    fd = os.open(fifo, os.O_RDWR)  # O_RDWR keeps the fifo alive without writers

    # Publish the pid only after the fifo is open: clients wait for this file
    # before writing, so they can never lose a copy to a startup race.
    try:
        with open(pidfile, "w", encoding="utf-8") as fh:
            fh.write(str(os.getpid()))
    except OSError:
        pass

    stop = {"flag": False}

    def reader() -> None:
        buf = b""
        while not stop["flag"]:
            try:
                data = os.read(fd, 4096)
            except OSError:
                break
            if not data:
                continue
            buf += data
            while b"\n" in buf:
                line, buf = buf.split(b"\n", 1)
                path = line.decode("utf-8", "replace").strip()
                if path:
                    GLib.idle_add(serve, path)

    threading.Thread(target=reader, daemon=True, name="clipboard-reader").start()

    def quit_daemon(*_args) -> None:
        stop["flag"] = True
        Gtk.main_quit()

    signal.signal(signal.SIGTERM, quit_daemon)
    signal.signal(signal.SIGINT, quit_daemon)
    try:
        Gtk.main()
    finally:
        try:
            os.unlink(pidfile)
        except OSError:
            pass
        try:
            os.close(fd)
        except OSError:
            pass
        try:
            os.close(lock_fd)
        except OSError:
            pass
    return 0


# ---------------------------------------------------------------------------
# Region selector
# ---------------------------------------------------------------------------


def monitor_geometry(pixbuf: GdkPixbuf.Pixbuf) -> tuple[int, int, int, int]:
    """The output under the pointer, clamped to the captured root image."""
    iw, ih = pixbuf.get_width(), pixbuf.get_height()
    try:
        display = Gdk.Display.get_default()
        _seat_screen, px, py = display.get_default_seat().get_pointer().get_position()
        monitor = display.get_monitor_at_point(px, py) or display.get_primary_monitor()
        geo = monitor.get_geometry()
        x, y, w, h = geo.x, geo.y, geo.width, geo.height
    except Exception:
        return 0, 0, iw, ih
    x = max(0, min(int(x), iw - 1))
    y = max(0, min(int(y), ih - 1))
    w = max(1, min(int(w), iw - x))
    h = max(1, min(int(h), ih - y))
    return x, y, w, h


class RegionSelector(Gtk.Window):
    """Full-screen dimmed selector using the pre-captured desktop as backdrop."""

    def __init__(self, pixbuf: GdkPixbuf.Pixbuf):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.origin_x, self.origin_y, mw, mh = monitor_geometry(pixbuf)
        self.pixbuf = crop_pixbuf(pixbuf, self.origin_x, self.origin_y, mw, mh)
        self.surface = surface_for(self.pixbuf)
        self.sw = self.pixbuf.get_width()
        self.sh = self.pixbuf.get_height()
        self.result: tuple[int, int, int, int] | None = None
        self.start: tuple[int, int] | None = None
        self.end: tuple[int, int] | None = None
        self.dragging = False
        self.grabbed = False
        self.done = False

        self.set_app_paintable(True)
        self.set_decorated(False)
        self.set_resizable(False)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_keep_above(True)
        self.set_accept_focus(True)
        self.set_can_focus(True)
        self.set_wmclass("screenshot-overlay", "screenshot-overlay")
        self.set_default_size(self.sw, self.sh)
        self.move(self.origin_x, self.origin_y)
        # Fullscreen (rather than a DOCK/override-redirect window) lets i3 put
        # the selector over the polybar too, so the whole output is selectable.
        self.fullscreen()

        self.add_events(
            Gdk.EventMask.BUTTON_PRESS_MASK
            | Gdk.EventMask.BUTTON_RELEASE_MASK
            | Gdk.EventMask.POINTER_MOTION_MASK
            | Gdk.EventMask.KEY_PRESS_MASK
            | Gdk.EventMask.KEY_RELEASE_MASK
            | Gdk.EventMask.STRUCTURE_MASK
        )
        self.connect("draw", self.on_draw)
        self.connect("map-event", self.on_map)
        self.connect("destroy", self.on_destroy)
        self.connect("button-press-event", self.on_press)
        self.connect("button-release-event", self.on_release)
        self.connect("motion-notify-event", self.on_motion)
        self.connect("key-press-event", self.on_key)
        self.connect("key-release-event", self.on_key_release)

    # -- lifecycle ---------------------------------------------------------
    def on_map(self, _widget, _event):
        window = self.get_window()
        if window is None:
            return False
        cursor = Gdk.Cursor.new_from_name(self.get_display(), "crosshair")
        window.set_cursor(cursor)
        seat = self.get_display().get_default_seat()
        status = seat.grab(
            window, Gdk.SeatCapabilities.ALL, False, cursor, None, None, None
        )
        self.grabbed = status == Gdk.GrabStatus.SUCCESS
        if not self.grabbed:
            try:
                window.focus(Gdk.CURRENT_TIME)
            except Exception:
                pass
        return False

    def _ungrab(self) -> None:
        if not self.grabbed:
            return
        try:
            self.get_display().get_default_seat().ungrab()
        except Exception:
            pass
        self.grabbed = False

    def on_destroy(self, *_args):
        self._ungrab()
        if not self.done:
            # Closed by something other than finish() (e.g. the WM): make sure
            # the selector's nested main loop does not leave the process stuck.
            self.done = True
            self.result = None
            GLib.idle_add(Gtk.main_quit)

    def finish(self, rect: tuple[int, int, int, int] | None) -> None:
        if self.done:
            return
        self.done = True
        if rect is not None:
            rect = (
                rect[0] + self.origin_x,
                rect[1] + self.origin_y,
                rect[2],
                rect[3],
            )
        self.result = rect
        self._ungrab()
        self.destroy()
        GLib.idle_add(Gtk.main_quit)

    # -- geometry ----------------------------------------------------------
    def selection_rect(self) -> tuple[int, int, int, int] | None:
        if self.start is None or self.end is None:
            return None
        x1, y1 = self.start
        x2, y2 = self.end
        x, y = min(x1, x2), min(y1, y2)
        w, h = abs(x2 - x1), abs(y2 - y1)
        if w < 1 or h < 1:
            return None
        return x, y, w, h

    def _clamp(self, x: int, y: int) -> tuple[int, int]:
        return max(0, min(x, self.sw)), max(0, min(y, self.sh))

    # -- events ------------------------------------------------------------
    def on_press(self, _widget, event):
        if event.button == 1:
            x, y = self._clamp(int(event.x), int(event.y))
            self.start = (x, y)
            self.end = (x, y)
            self.dragging = True
            self.queue_draw()
        elif event.button == 3:
            self.finish(None)
        return True

    def on_motion(self, _widget, event):
        if not self.dragging or self.start is None:
            return True
        x, y = self._clamp(int(event.x), int(event.y))
        if event.state & Gdk.ModifierType.SHIFT_MASK:
            dx = x - self.start[0]
            dy = y - self.start[1]
            side = max(abs(dx), abs(dy))
            x = self.start[0] + (side if dx >= 0 else -side)
            y = self.start[1] + (side if dy >= 0 else -side)
            x, y = self._clamp(x, y)
        self.end = (x, y)
        self.queue_draw()
        return True

    def on_release(self, _widget, event):
        if event.button != 1 or not self.dragging:
            return True
        self.dragging = False
        rect = self.selection_rect()
        if rect and rect[2] >= 3 and rect[3] >= 3:
            self.finish(rect)
        else:
            self.start = self.end = None
            self.queue_draw()
        return True

    def on_key(self, _widget, event):
        if event.keyval == Gdk.KEY_Escape:
            self.finish(None)
            return True
        if event.keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            rect = self.selection_rect()
            if rect and rect[2] >= 3 and rect[3] >= 3:
                self.finish(rect)
                return True
        return False

    def on_key_release(self, _widget, _event):
        return False

    # -- painting ----------------------------------------------------------
    def on_draw(self, _widget, cr):
        cr.set_source_surface(self.surface, 0, 0)
        cr.paint()

        rect = self.selection_rect()
        cr.set_source_rgba(0.03, 0.03, 0.03, 0.58)
        cr.rectangle(0, 0, self.sw, self.sh)
        cr.fill()

        if rect:
            x, y, w, h = rect
            # Punch the selection out of the dim layer.
            cr.save()
            cr.rectangle(x, y, w, h)
            cr.clip()
            cr.set_source_surface(self.surface, 0, 0)
            cr.paint()
            cr.restore()

            cr.set_source_rgba(0.78, 0.78, 0.78, 1)
            cr.set_line_width(1)
            cr.rectangle(x + 0.5, y + 0.5, max(0, w - 1), max(0, h - 1))
            cr.stroke()

            for hx, hy in ((x, y), (x + w, y), (x, y + h), (x + w, y + h)):
                cr.set_source_rgba(0.94, 0.94, 0.94, 1)
                cr.rectangle(hx - 2.5, hy - 2.5, 5, 5)
                cr.fill()
                cr.set_source_rgba(0.08, 0.08, 0.08, 1)
                cr.rectangle(hx - 2.5, hy - 2.5, 5, 5)
                cr.set_line_width(1)
                cr.stroke()

            label = f"{w} × {h}"
            layout = PangoCairo.create_layout(cr)
            layout.set_font_description(Pango.FontDescription("JetBrainsMono Nerd Font Bold 10"))
            layout.set_text(label, -1)
            tw, th = layout.get_pixel_size()
            pad = 7
            lx = x + w - tw - pad * 2
            ly = y - th - pad * 2 - 6
            if ly < 4:
                ly = y + 6
            if lx < 4:
                lx = x + 6
            cr.set_source_rgba(0.05, 0.05, 0.05, 0.9)
            rounded_rect(cr, lx, ly, tw + pad * 2, th + pad * 2, 4)
            cr.fill()
            cr.set_source_rgba(0.16, 0.16, 0.16, 1)
            cr.set_line_width(1)
            rounded_rect(cr, lx + 0.5, ly + 0.5, tw + pad * 2 - 1, th + pad * 2 - 1, 4)
            cr.stroke()
            cr.set_source_rgb(*hex_to_rgb(FG))
            cr.move_to(lx + pad, ly + pad)
            PangoCairo.show_layout(cr, layout)
        else:
            text = "Click and drag to select   ·   Esc to cancel"
            layout = PangoCairo.create_layout(cr)
            layout.set_font_description(Pango.FontDescription("JetBrainsMono Nerd Font 10"))
            layout.set_text(text, -1)
            tw, th = layout.get_pixel_size()
            pad = 12
            bx = (self.sw - tw) / 2 - pad
            by = (self.sh - th) / 2 - pad
            cr.set_source_rgba(0.05, 0.05, 0.05, 0.86)
            rounded_rect(cr, bx, by, tw + pad * 2, th + pad * 2, 5)
            cr.fill()
            cr.set_source_rgba(0.16, 0.16, 0.16, 1)
            cr.set_line_width(1)
            rounded_rect(cr, bx + 0.5, by + 0.5, tw + pad * 2 - 1, th + pad * 2 - 1, 5)
            cr.stroke()
            cr.set_source_rgb(*hex_to_rgb(FG_DIM))
            cr.move_to(bx + pad, by + pad)
            PangoCairo.show_layout(cr, layout)
        return False

    @classmethod
    def select(cls, pixbuf: GdkPixbuf.Pixbuf) -> tuple[int, int, int, int] | None:
        selector = cls(pixbuf)
        selector.show_all()
        selector.present()
        Gtk.main()
        return selector.result


# ---------------------------------------------------------------------------
# Annotation editor
# ---------------------------------------------------------------------------


def draw_arrow(cr, shape: dict) -> None:
    x1, y1 = shape["x1"], shape["y1"]
    x2, y2 = shape["x2"], shape["y2"]
    color = shape["color"]
    width = shape["width"]
    angle = math.atan2(y2 - y1, x2 - x1)
    head = max(12.0, width * 4.5)

    # Body, with a soft dark halo so it reads on light and dark images.
    for lw, col in ((width + 2.0, (0, 0, 0, 0.35)), (width, color)):
        cr.set_line_width(lw)
        cr.set_source_rgba(*col)
        cr.move_to(x1, y1)
        cr.line_to(x2 - math.cos(angle) * head * 0.65, y2 - math.sin(angle) * head * 0.65)
        cr.stroke()

    left = (x2 - head * math.cos(angle - 0.42), y2 - head * math.sin(angle - 0.42))
    right = (x2 - head * math.cos(angle + 0.42), y2 - head * math.sin(angle + 0.42))
    cr.move_to(x2, y2)
    cr.line_to(*left)
    cr.line_to(*right)
    cr.close_path()
    cr.set_source_rgba(0, 0, 0, 0.35)
    cr.set_line_width(max(2.0, width * 0.8))
    cr.stroke_preserve()
    cr.set_source_rgba(*color)
    cr.fill()


def draw_rect_shape(cr, shape: dict, ellipse: bool = False) -> None:
    x1, y1 = shape["x1"], shape["y1"]
    x2, y2 = shape["x2"], shape["y2"]
    x, y = min(x1, x2), min(y1, y2)
    w, h = abs(x2 - x1), abs(y2 - y1)
    if w < 1 or h < 1:
        return
    color, width = shape["color"], shape["width"]
    for lw, col in ((width + 2.0, (0, 0, 0, 0.35)), (width, color)):
        cr.set_line_width(lw)
        cr.set_source_rgba(*col)
        if ellipse:
            cr.save()
            cr.translate(x + w / 2, y + h / 2)
            cr.scale(max(w / 2, 0.1), max(h / 2, 0.1))
            cr.arc(0, 0, 1, 0, math.tau)
            cr.restore()
            cr.stroke()
        else:
            cr.rectangle(x, y, w, h)
            cr.stroke()


def draw_pen(cr, shape: dict) -> None:
    points = shape["points"]
    if len(points) < 2:
        return
    color, width = shape["color"], shape["width"]
    for lw, col in ((width + 2.0, (0, 0, 0, 0.35)), (width, color)):
        cr.set_line_width(lw)
        cr.set_source_rgba(*col)
        cr.move_to(*points[0])
        for point in points[1:]:
            cr.line_to(*point)
        cr.stroke()


def draw_text(cr, shape: dict) -> None:
    text = shape.get("text", "")
    if not text:
        return
    size = shape.get("size", 24)
    desc = Pango.FontDescription(f"JetBrainsMono Nerd Font Bold {size}")
    layout = PangoCairo.create_layout(cr)
    layout.set_font_description(desc)
    layout.set_text(text, -1)
    x, y = shape["x"], shape["y"]
    cr.save()
    cr.translate(x + 1.5, y + 1.5)
    cr.set_source_rgba(0, 0, 0, 0.55)
    PangoCairo.show_layout(cr, layout)
    cr.restore()
    cr.save()
    cr.translate(x, y)
    cr.set_source_rgba(*shape["color"])
    PangoCairo.show_layout(cr, layout)
    cr.restore()


def draw_pixelate(cr, shape: dict, base_surface) -> None:
    x1, y1 = shape["x1"], shape["y1"]
    x2, y2 = shape["x2"], shape["y2"]
    x, y = min(x1, x2), min(y1, y2)
    w, h = abs(x2 - x1), abs(y2 - y1)
    if w < 3 or h < 3 or base_surface is None:
        return
    block = max(6, int(shape["width"] * 3))
    sw = max(1, int(w / block))
    sh = max(1, int(h / block))
    tmp = cairo.ImageSurface(cairo.FORMAT_ARGB32, sw, sh)
    tctx = cairo.Context(tmp)
    tctx.scale(sw / w, sh / h)
    tctx.set_source_surface(base_surface, -x, -y)
    tctx.get_source().set_filter(cairo.FILTER_BILINEAR)
    tctx.paint()
    cr.save()
    cr.rectangle(x, y, w, h)
    cr.clip()
    cr.translate(x, y)
    cr.scale(w / sw, h / sh)
    cr.set_source_surface(tmp, 0, 0)
    cr.get_source().set_filter(cairo.FILTER_NEAREST)
    cr.paint()
    cr.restore()


def draw_shape(cr, shape: dict, base_surface=None) -> None:
    kind = shape["type"]
    cr.save()
    cr.set_line_cap(cairo.LINE_CAP_ROUND)
    cr.set_line_join(cairo.LINE_JOIN_ROUND)
    if kind == "arrow":
        draw_arrow(cr, shape)
    elif kind == "rect":
        draw_rect_shape(cr, shape, ellipse=False)
    elif kind == "ellipse":
        draw_rect_shape(cr, shape, ellipse=True)
    elif kind == "pen":
        draw_pen(cr, shape)
    elif kind == "text":
        draw_text(cr, shape)
    elif kind == "pixelate":
        draw_pixelate(cr, shape, base_surface)
    cr.restore()


