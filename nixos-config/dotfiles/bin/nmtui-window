#!/usr/bin/env bash
#
# nmtui-window - toggle NetworkManager's nmtui in a small floating window.
#
# i3 owns the appearance (see ~/.config/i3/config):
#   for_window [class="^nmtui\.local$"] mark --replace nmtui,
#       floating enable, resize set width 820 px height 560 px,
#       move position center, move scratchpad
# so this script starts the terminal on first use and afterwards toggles the
# parked scratchpad window with each press of Alt+N.
set -u

CLASS=nmtui.local
TERM_CMD="${TERMINAL:-ghostty}"

have_i3() {
    command -v i3-msg >/dev/null 2>&1 && i3-msg -t get_version >/dev/null 2>&1
}

msgs() { i3-msg "[class=\"^${CLASS//./\\.}\$\"] $1" >/dev/null 2>&1; }

# "<workspace>\t<focused>" for the nmtui window, or nothing if it is not there.
# A parked scratchpad window lives under the __i3_scratch workspace, which is
# how "show it" is told apart from "it is already up".
window_state() {
    local tree
    tree=$(i3-msg -t get_tree 2>/dev/null) || return 1
    command -v jq >/dev/null 2>&1 || return 1
    jq -r --arg c "$CLASS" '
        def scan($ws):
            (if .type == "workspace" then .name else $ws end) as $w
            | if ((.window_properties // {}).class // "") == $c
              then "\($w)\t\(.focused // false)"
              else (((.nodes // [])[] | scan($w)),
                    ((.floating_nodes // [])[] | scan($w)))
              end;
        scan("")' <<<"$tree" 2>/dev/null | head -n1
}

window_exists() {
    local tree
    tree=$(i3-msg -t get_tree 2>/dev/null) || return 1
    if command -v jq >/dev/null 2>&1; then
        jq -e --arg c "$CLASS" \
            '.. | objects | select((.window_properties // {}).class == $c)' \
            <<<"$tree" >/dev/null 2>&1
    else
        grep -q "\"class\":\"$CLASS\"" <<<"$tree"
    fi
}

show_focus() {
    local state i
    msgs "scratchpad show"
    for i in $(seq 1 12); do
        msgs "focus"
        state=$(window_state)
        [[ ${state##*$'\t'} == true ]] && return 0
        sleep 0.05
    done
    return 0
}

toggle() {
    local state ws focused
    state=$(window_state) || state=""
    if [[ -z $state ]]; then
        # no jq (or a race): fall back to i3's own scratchpad toggle
        show_focus
        return 0
    fi
    ws=${state%%$'\t'*}
    focused=${state##*$'\t'}
    if [[ $ws == "__i3_scratch" ]]; then
        show_focus          # parked -> show
    elif [[ $focused == true ]]; then
        msgs "move scratchpad"  # up and focused -> hide
    else
        msgs "focus"            # up but unfocused -> just focus
    fi
}

# Outside i3 (plain shell): just run nmtui in a small terminal.
if ! have_i3; then
    exec "$TERM_CMD" --class="$CLASS" --title="nmtui" \
        --window-width=108 --window-height=32 -e nmtui
fi

if window_exists; then
    toggle
    exit 0
fi

"$TERM_CMD" --class="$CLASS" --title="nmtui" \
    --window-width=108 --window-height=32 -e nmtui >/dev/null 2>&1 &

# for_window parks the new window in the scratchpad, so wait until it exists
# and then pull it onto the current workspace and focus it.
for _ in $(seq 1 100); do
    if window_exists; then
        sleep 0.1           # let the for_window rule park it first
        show_focus
        exit 0
    fi
    sleep 0.05
done

exit 1
