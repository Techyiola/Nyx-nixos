#!/usr/bin/env bash
# sleep-toggle - toggle a systemd inhibitor that blocks idle/suspend/lid-close sleep.
#
#   sleep-toggle            toggle
#   sleep-toggle on|off     turn the blocker on or off
#   sleep-toggle status     print "on" or "off"
#   sleep-toggle bar        label for polybar: " awake " or " drowsy "
#   sleep-toggle --quiet    no output; exit 0 if on, 1 if off (for scripts/polybar)
#
# The lock is held by a `systemd-inhibit ... sleep infinity` process. Its PID
# lives in $XDG_RUNTIME_DIR/sleep-toggle.pid and never outlives the login
# session (runtime dir is wiped on logout).
set -uo pipefail

runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"
pid_file="$runtime_dir/sleep-toggle.pid"
mkdir -p "$runtime_dir"

# Serialise concurrent invocations (e.g. double-click on the polybar chip).
if command -v flock >/dev/null 2>&1; then
    exec 9>"$runtime_dir/sleep-toggle.lock"
    flock -n 9 || exit 0
fi

# Print the inhibitor PID if it is still alive and really ours.
active_pid() {
    local pid
    [[ -r $pid_file ]] || return 1
    read -r pid < "$pid_file" 2>/dev/null || return 1
    [[ $pid =~ ^[0-9]+$ ]] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    # Guard against PID reuse.
    grep -qa 'systemd-inhibit' "/proc/$pid/cmdline" 2>/dev/null || return 1
    printf '%s\n' "$pid"
}

is_active() { active_pid >/dev/null 2>&1; }

notify() {
    command -v notify-send >/dev/null 2>&1 || return 0
    notify-send -a "Sleep toggle" \
        -h string:x-canonical-private-synchronous:sleep-toggle "$@" 2>/dev/null || true
}

turn_on() {
    local pid
    if pid=$(active_pid); then
        notify "Sleep blocker already on" "Suspend is blocked (PID $pid)"
        return 0
    fi
    rm -f "$pid_file"

    # 9>&- keeps the child from inheriting (and thus holding) the flock fd.
    if command -v setsid >/dev/null 2>&1; then
        setsid systemd-inhibit --what=idle:sleep:handle-lid-switch --who="sleep-toggle" \
            --why="Disabled by user via sleep-toggle" --mode=block \
            sleep infinity 9>&- &
    else
        systemd-inhibit --what=idle:sleep:handle-lid-switch --who="sleep-toggle" \
            --why="Disabled by user via sleep-toggle" --mode=block \
            sleep infinity 9>&- &
    fi
    pid=$!
    printf '%s\n' "$pid" > "$pid_file"

    # Give systemd-inhibit a beat to register with logind.
    sleep 0.3
    if is_active; then
        notify "Sleep blocker ON" "Suspend, hibernate and lid-close sleep are blocked"
    else
        rm -f "$pid_file"
        notify -u critical "Sleep blocker failed" "Could not start systemd-inhibit"
        return 1
    fi
}

turn_off() {
    local pid
    if pid=$(active_pid); then
        pkill -TERM -P "$pid" 2>/dev/null || true   # child `sleep infinity`
        kill "$pid" 2>/dev/null || true
        rm -f "$pid_file"
        notify "Sleep blocker OFF" "Normal suspend behaviour restored"
    else
        rm -f "$pid_file"
        notify "Sleep blocker already off" "Normal suspend behaviour restored"
    fi
}

case "${1:-toggle}" in
    toggle) if is_active; then turn_off; else turn_on; fi ;;
    on)     turn_on ;;
    off)    turn_off ;;
    status) if is_active; then echo on; else echo off; fi ;;
    bar)    if is_active; then printf '%%{O4} awake %%{O4}'; else printf ' drowsy '; fi ;;
    --quiet|quiet) is_active ;;
    *)
        echo "usage: ${0##*/} [toggle|on|off|status|bar|--quiet]" >&2
        exit 2
        ;;
esac
