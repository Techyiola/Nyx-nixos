## Here is a language switcher by pressing capslock button,
## and the capslock functionality available by using shift+capslock.
## Uncomment to enable 'us' to/from 'ru' switch. change to language(s) you prefer more.

#exec_always setxkbmap -option grp:caps_toggle "us,ru" -option "grp:caps_toggle,grp_led:caps"

# Apply X resources (cursor theme/size) at startup
exec_always --no-startup-id xrdb -merge ~/.Xresources

# Display setup. ~/.config/i3/display.sh picks the primary output and applies
# its MODE/RATE (falls back to `xrandr --auto`). Edit it for your monitor.
exec_always --no-startup-id ~/.config/i3/display.sh

exec feh --bg-fill ~/.config/i3/wallpaper.png

exec --no-startup-id dunst
exec --no-startup-id picom
# Keep image clipboard contents alive between screenshot runs (single instance;
# the daemon locks, so an i3 reload cannot spawn duplicates).
exec --no-startup-id ~/.local/bin/screenshot --clipboard-daemon
# Stop the X server blanking the screen / DPMS powering off the display when idle.
# xorg-xset is installed; keep-awake-display.timer re-applies this every minute because
# the X setting does not survive a reboot and some apps reset it.
exec_always --no-startup-id xset s off -dpms
# Lock on suspend / lid close via logind (needs the xss-lock package).
# Silent no-op when xss-lock isn't installed. --nofork keeps the locker in the
# foreground so xss-lock can hold back suspend until the screen is actually locked.
exec --no-startup-id sh -c 'command -v xss-lock >/dev/null && exec xss-lock --transfer-sleep-lock -- ~/.local/bin/lock --nofork'
# SNI -> XEmbed bridge so blueman-tray (StatusNotifierItem) shows in polybar's tray
exec --no-startup-id snixembed
exec --no-startup-id blueman-applet
# redshift was referenced by the old CachyOS setup but was not configured or
# installed there. NixOS provides it through services.redshift if you want it.
#exec --no-startup-id redshift
exec --no-startup-id dex -a -s /etc/xdg/autostart/:~/.config/autostart/
exec --no-startup-id ~/.local/bin/polkit-agent

