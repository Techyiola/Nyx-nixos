########################################################################

exec --no-startup-id "i3-msg 'workspace 1; exec ghostty'"

########################################################################
########################################################################
####
####                   Floated windows
####
########################################################################
########################################################################

for_window [title="Calculator"] floating enable
for_window [title="Timer"] floating enable
for_window [class="^.*"] border pixel 1
for_window [class="librewolf"] border none
for_window [class="firefox"] border none
for_window [class="mpv"] floating enable
for_window [class="imv"] floating enable
for_window [class="zenity"] floating enable

# nmtui: small centred floating window, parked in the scratchpad and toggled
# by ~/.local/bin/nmtui-window (Alt+N)
for_window [class="^nmtui\.local$"] mark --replace nmtui, floating enable, resize set width 820 px height 560 px, move position center, move scratchpad

# btop: floating window, parked in the scratchpad and toggled by
# ~/.local/bin/btop-window (Alt+B)
for_window [class="^btop\.local$"] mark --replace btop, floating enable, resize set width 1100 px height 700 px, move position center, move scratchpad

# bluetui: floating window, parked in the scratchpad and toggled by
# ~/.local/bin/bluetooth-menu-window (Super+B)
for_window [class="^bluetoothmenu\.local$"] mark --replace bluetoothmenu, floating enable, move position center, move scratchpad

# floating terminal: parked in the scratchpad and toggled by
# ~/.local/bin/floating-terminal (Super+T)
# No pixel resize here: the size comes from Ghostty's own cell grid. The helper
# realises the window with zero opacity, waits for Ghostty to settle on its real
# (fractional) cell size, centres it, and only then fades it back in, so the
# resize is never visible.
for_window [class="^floatingterm\.local$"] mark --replace floatingterm, floating enable, move position center, move scratchpad

# fetch: animated logo popup, same treatment, toggled by
# ~/.local/bin/fetch-window (Alt+F)
for_window [class="^fetch\.local$"] mark --replace fetch, floating enable, move position center, move scratchpad

# lazydocker: floating window sized by Ghostty's cell grid, parked in the
# scratchpad and toggled by ~/.local/bin/lazydocker-window (Alt+D)
for_window [class="^lazydocker\.local$"] mark --replace lazydocker, floating enable, move position center, move scratchpad

# Screenshot windows: the region selector goes fullscreen over the bar, and
# the annotation editor stays centred/floating instead of joining the layout.
for_window [class="^screenshot-overlay$"] floating enable, border none, fullscreen enable, move position 0 0
for_window [class="^screenshot-editor$"] floating enable, border pixel 1, move position center

########################################################################
########################################################################
####
####                   HOTKEYS
####
########################################################################
########################################################################


# Volume + mute keys, with the minimal monochrome xob OSD
# (~/.local/bin/osd -> ~/.config/xob/styles.cfg). The polybar volume
# module still shows the level; the OSD is the Omarchy-style feedback.
bindsym XF86AudioRaiseVolume exec --no-startup-id ~/.local/bin/volume up
bindsym XF86AudioLowerVolume exec --no-startup-id ~/.local/bin/volume down
# mute sound
bindsym XF86AudioMute exec --no-startup-id ~/.local/bin/volume mute

# screen brightness (internal backlight, via systemd-logind — needs no root)
# Same OSD, capped at 1..100% so the panel can never go fully black.
bindsym XF86MonBrightnessUp exec --no-startup-id ~/.local/bin/brightness up
bindsym XF86MonBrightnessDown exec --no-startup-id ~/.local/bin/brightness down

# Mod+C: toggle the sleep blocker (blocks suspend/hibernate until toggled back).
# Feedback via dunst; while on, polybar shows an "awake" chip.
bindsym $mod+c exec --no-startup-id ~/.local/bin/sleep-toggle

# Screenshots
# Print: select a region, annotate it, then copy and/or save
bindsym Print exec --no-startup-id ~/.local/bin/screenshot region
# Shift+Print: full screen straight to the clipboard
bindsym Shift+Print exec --no-startup-id ~/.local/bin/screenshot full
# Mod+Print: full screen saved to ~/Pictures/Screenshots and copied
bindsym $mod+Print exec --no-startup-id ~/.local/bin/screenshot save
# Mod+Shift+Print: capture the focused window, then annotate it
bindsym $mod+Shift+Print exec --no-startup-id ~/.local/bin/screenshot window
# Mod+Shift+S: rofi screenshot menu (region/window/full, plus a 3s delay)
bindsym $mod+Shift+s exec --no-startup-id ~/.local/bin/screenshot menu

# launch browser (Zen)
bindsym $mod+w exec zen-beta

# launch file manager (Dolphin)
bindsym $mod+e exec dolphin 


